{
  "name": "dsh-session-trash",
  "version": "1.7.0",
  "description": "Session deletion for the DSH Web GUI: a two-step confirmation, batch selection, and a recoverable recycle bin — the delete action DSH itself does not ship. · DSH 网页端会话删除：两步确认、批量选择与可恢复的回收站，补上 DSH 本身没有的删除能力。",
  "icon": "icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs",
    "locale/*.json",
    "assets/*.png"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/host/*.test.js\" \"tests/client/*.test.js\" \"tests/integration/*.test.js\"",
    "test:host": "node --test --test-concurrency=1 \"tests/host/*.test.js\"",
    "test:client": "node --test --test-concurrency=1 \"tests/client/*.test.js\"",
    "test:render": "node --test --test-concurrency=1 \"tests/integration/*.test.js\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "delete",
    "recycle-bin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuilian/dsh-session-trash.git"
  },
  "homepage": "https://github.com/chuilian/dsh-session-trash#readme",
  "bugs": {
    "url": "https://github.com/chuilian/dsh-session-trash/issues"
  }
}
